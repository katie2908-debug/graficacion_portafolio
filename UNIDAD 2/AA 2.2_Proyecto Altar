let modoLuz = true;

function setup() {
  // Lienzo responsivo adaptable
  createCanvas(windowWidth, windowHeight);
  angleMode(DEGREES);
}

function draw() {
  background(22, 12, 32); // Fondo nocturno tradicional

  // 1. Papel Picado colgado en el techo
  dibujarPapelPicadoTecho();

  // 2. Arco de Cempasúchil sobre el altar
  dibujarArcoCempasuchil(width * 0.5, height * 0.28, 290, 190);

  // 3. Estructura del Altar de Niveles con Papel Picado
  dibujarAltarConManteles();

  // 4. Elementos de la ofrenda (Pan, comida, frutas, calaveritas y servidor ISC)
  dibujarElementosMesa();

  // 5. Cruz de Cempasúchil en el piso
  dibujarCruzSuelo(width * 0.5, height * 0.88);

  // 6. Catrina a la izquierda moviendo el abanico
  dibujarCatrina(width * 0.2, height * 0.62);

  // 7. Mariachi Esqueleto a la derecha tocando la guitarra
  dibujarMariachiGuitarrista(width * 0.8, height * 0.62);

  // 8. Perrito Xoloitzcuintle moviendo la cola
  dibujarPerrito(width * 0.32, height * 0.82);

  // 9. Veladoras animadas con scale()
  dibujarVeladora(width * 0.36, height * 0.71);
  dibujarVeladora(width * 0.64, height * 0.71);
  dibujarVeladora(width * 0.41, height * 0.54);
  dibujarVeladora(width * 0.59, height * 0.54);

  // 10. Flores de Cempasúchil decorativas rotando en (0,0)
  dibujarFlorCempasuchil(width * 0.28, height * 0.76, 32);
  dibujarFlorCempasuchil(width * 0.72, height * 0.76, 32);

  // 11. Interactividad de Luz con el cursor
  dibujarLuzInteractiva();
}

// Reajuste automático al cambiar el tamaño de ventana
function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
}

// Cambia el modo de ambiente al hacer clic
function mousePressed() {
  modoLuz = !modoLuz;
}

//ESTRUCTURA Y DECORACIÓN DEL ALTAR

function dibujarPapelPicadoTecho() {
  push();
  noStroke();
  let colores = [color(235, 52, 137), color(255, 153, 0), color(0, 180, 216), color(155, 89, 182)];
  let numBanderas = 12;
  let ancho = width / numBanderas;

  for (let i = 0; i < numBanderas; i++) {
    let oscilacion = sin(frameCount * 2 + i * 30) * 4;
    fill(colores[i % colores.length]);
    rect(i * ancho, 0 + oscilacion, ancho - 3, 40, 0, 0, 8, 8);
  }
  pop();
}

function dibujarAltarConManteles() {
  push();
  rectMode(CENTER);
  noStroke();

  // Nivel inferior
  fill(130, 30, 150);
  rect(width * 0.5, height * 0.78, width * 0.52, 70, 6);
  fill(255, 0, 128);
  rect(width * 0.5, height * 0.81, width * 0.52, 12);

  // Nivel medio
  fill(220, 25, 95);
  rect(width * 0.5, height * 0.66, width * 0.42, 60, 6);
  fill(255, 140, 0);
  rect(width * 0.5, height * 0.685, width * 0.42, 10);

  // Nivel superior
  fill(245, 100, 35);
  rect(width * 0.5, height * 0.54, width * 0.3, 50, 6);
  fill(0, 200, 230);
  rect(width * 0.5, height * 0.56, width * 0.3, 8);

  pop();
}

//DETALLES DE LA OFRENDA Y ELEMENTOS MESA

function dibujarElementosMesa() 
{
  // NIVEL SUPERIOR: Servidor ISC, Retrato y Calaverita
  dibujarServidorTech(width * 0.5, height * 0.44);
  dibujarRetrato(width * 0.41, height * 0.46);
  dibujarCalaveritaAzucar(width * 0.58, height * 0.48, color(255, 0, 120), 22);

  // NIVEL MEDIO: Pan de Muerto, Vaso de agua, Sal, Fruta y Comida
  dibujarPanDeMuerto(width * 0.5, height * 0.60, 36);
  dibujarVasoAgua(width * 0.42, height * 0.61);
  dibujarPlatoSal(width * 0.57, height * 0.62);
  dibujarFrutas(width * 0.36, height * 0.61);
  dibujarCazuelaComida(width * 0.63, height * 0.61);

  // NIVEL INFERIOR: Calaveritas de azúcar grandes
  dibujarCalaveritaAzucar(width * 0.44, height * 0.73, color(0, 210, 255), 28);
  dibujarCalaveritaAzucar(width * 0.56, height * 0.73, color(255, 215, 0), 28);
}

// Servidor de Sistemas con el texto "Orgullosamente ISC"
function dibujarServidorTech(x, y) {
  push();
  translate(x, y);
  fill(25, 30, 45);
  stroke(0, 255, 200);
  strokeWeight(2);
  rectMode(CENTER);
  rect(0, 0, 95, 55, 6);

  noStroke();
  fill(0, 255, 140);
  textSize(9);
  textAlign(CENTER, CENTER);
  text("Orgullosamente\nISC", 0, -6);

  // Microchip en la base
  fill(255, 190, 0);
  rect(0, 16, 12, 12, 2);
  pop();
}

function dibujarRetrato(x, y) {
  push();
  translate(x, y);
  fill(218, 165, 32);
  stroke(120, 90, 10);
  strokeWeight(2);
  rectMode(CENTER);
  rect(0, 0, 26, 34, 3);
  
  fill(240, 230, 210);
  noStroke();
  rect(0, -1, 20, 26);
  
  fill(70);
  ellipse(0, -3, 8, 8);
  arc(0, 8, 14, 12, 180, 360);
  pop();
}

function dibujarPanDeMuerto(x, y, tam) {
  push();
  translate(x, y);
  noStroke();
  fill(180, 115, 50);
  arc(0, 4, tam, tam * 0.75, 180, 360);
  
  fill(240, 225, 200);
  ellipse(0, -tam * 0.3, 6, 6);
  stroke(240, 225, 200);
  strokeWeight(2.5);
  line(-tam * 0.35, -2, tam * 0.35, -2);
  line(-tam * 0.25, -tam * 0.2, tam * 0.25, 4);
  pop();
}

function dibujarVasoAgua(x, y) {
  push();
  translate(x, y);
  stroke(200, 230, 255);
  strokeWeight(1);
  fill(150, 220, 255, 180);
  quad(-7, -12, 7, -12, 5, 8, -5, 8);
  pop();
}

function dibujarPlatoSal(x, y) {
  push();
  translate(x, y);
  fill(180, 90, 40);
  noStroke();
  ellipse(0, 2, 22, 10);
  fill(250);
  ellipse(0, 0, 16, 6);
  pop();
}

function dibujarCazuelaComida(x, y) {
  push();
  translate(x, y);
  fill(140, 65, 25);
  noStroke();
  arc(0, 0, 26, 20, 0, 180);
  fill(60, 25, 10);
  ellipse(0, 0, 24, 8);
  fill(240);
  ellipse(-3, -1, 2, 2);
  ellipse(3, 1, 2, 2);
  pop();
}

function dibujarFrutas(x, y) {
  push();
  translate(x, y);
  fill(200, 200, 210);
  ellipse(0, 4, 26, 8);
  noStroke();
  fill(255, 140, 0);
  ellipse(-5, 0, 10, 10);
  fill(220, 30, 30);
  ellipse(4, -1, 9, 9);
  pop();
}

function dibujarCalaveritaAzucar(x, y, colorDetalle, tam) {
  push();
  translate(x, y);
  fill(250);
  stroke(60);
  strokeWeight(1.5);
  
  ellipse(0, -tam * 0.1, tam, tam);
  rectMode(CENTER);
  rect(0, tam * 0.3, tam * 0.6, tam * 0.4, 2);

  noStroke();
  fill(colorDetalle);
  ellipse(-tam * 0.2, -tam * 0.15, tam * 0.3, tam * 0.3);
  ellipse(tam * 0.2, -tam * 0.15, tam * 0.3, tam * 0.3);

  fill(50);
  triangle(0, 0, -3, 6, 3, 6);
  pop();
}

//ANIMACION SECUNDARIA

function dibujarArcoCempasuchil(x, y, ancho, alto) {
  push();
  translate(x, y);
  for (let a = 180; a <= 360; a += 14) {
    let px = (ancho / 2) * cos(a);
    let py = (alto / 2) * sin(a);
    dibujarFlorCempasuchil(px, py, 26);
  }
  pop();
}

function dibujarFlorCempasuchil(x, y, tam) {
  push();
  translate(x, y);
  rotate(frameCount * 1.5); // Rotación local sobre (0,0)
  noStroke();
  fill(255, 140, 0);
  for (let i = 0; i < 360; i += 45) {
    push();
    rotate(i);
    ellipse(tam * 0.25, 0, tam * 0.5, tam * 0.25);
    pop();
  }
  fill(230, 81, 0);
  ellipse(0, 0, tam * 0.35, tam * 0.35);
  pop();
}

function dibujarVeladora(x, y) {
  push();
  translate(x, y);
  fill(245);
  stroke(200);
  strokeWeight(1);
  rectMode(CENTER);
  rect(0, 0, 16, 24, 3);

  // Flama con oscilación de escala (scale)
  push();
  translate(0, -14);
  let cambioEscala = 1 + sin(frameCount * 15 + x) * 0.22;
  scale(cambioEscala);
  noStroke();
  fill(255, 160, 0, 220);
  ellipse(0, 0, 11, 17);
  fill(255, 235, 59);
  ellipse(0, 2, 5, 9);
  pop();

  pop();
}

// MARIACHI TOCANDO GUITARRA (Anidación Jerárquica)
function dibujarMariachiGuitarrista(x, y) {
  push();
  translate(x, y);

  // Cuerpo y Traje
  fill(20);
  rectMode(CENTER);
  rect(0, 20, 28, 45, 5);
  fill(245);
  ellipse(0, -18, 32, 32);
  fill(20);
  ellipse(-7, -20, 7, 9);
  ellipse(7, -20, 7, 9);

  // Sombrero Mariachi
  fill(35);
  stroke(255, 215, 0);
  strokeWeight(2);
  ellipse(0, -32, 70, 20);
  rect(0, -42, 30, 20, 4);

  // Guitarra fija
  push();
  translate(0, 15);
  rotate(-15);
  fill(186, 104, 200);
  noStroke();
  ellipse(-12, 0, 26, 32);
  rect(15, 0, 35, 7);
  pop();

  // BRAZO JERÁRQUICO TOCANDO GUITARRA
  push();
  translate(-10, 10); // Hombro derecho
  let anguloRasgueo = sin(frameCount * 12) * 20;
  rotate(anguloRasgueo);

  stroke(245);
  strokeWeight(5);
  line(0, 0, 15, 15);

  fill(245);
  noStroke();
  ellipse(15, 15, 7, 7);
  pop();

  // Notas musicales flotantes
  let notaY = (frameCount * 2) % 60;
  fill(255, 235, 59, 255 - notaY * 4);
  noStroke();
  textSize(14);
  text("♪", -25, -notaY);

  pop();
}

// LA CATRINA CON ABANICO
function dibujarCatrina(x, y) {
  push();
  translate(x, y);

  fill(0, 150, 136);
  triangle(0, 0, -30, 60, 30, 60);

  fill(245);
  ellipse(0, -15, 28, 28);
  fill(20);
  ellipse(-6, -16, 6, 8);
  ellipse(6, -16, 6, 8);

  fill(233, 30, 99);
  ellipse(0, -28, 65, 16);

  // BRAZO JERÁRQUICO MOVIENDO ABANICO
  push();
  translate(10, 10);
  let anguloAbanico = sin(frameCount * 8) * 15 - 10;
  rotate(anguloAbanico);

  stroke(245);
  strokeWeight(4);
  line(0, 0, 15, -5);

  noStroke();
  fill(255, 193, 7);
  arc(18, -8, 22, 22, 180, 310);
  pop();

  pop();
}

// PERRITO XOLOITZCUINTLE
function dibujarPerrito(x, y) {
  push();
  translate(x, y);

  fill(60);
  noStroke();
  ellipse(0, 0, 26, 20);
  ellipse(-12, -10, 18, 18);
  triangle(-18, -22, -12, -14, -8, -22);

  fill(255);
  ellipse(-14, -12, 4, 4);

  // COLA MOVIÉNDOSE
  push();
  translate(12, -2);
  rotate(sin(frameCount * 15) * 25);
  stroke(60);
  strokeWeight(3);
  line(0, 0, 12, -8);
  pop();

  pop();
}

function dibujarCruzSuelo(x, y) {
  push();
  translate(x, y);
  for (let i = -30; i <= 30; i += 15) {
    dibujarFlorCempasuchil(0, i, 16);
    dibujarFlorCempasuchil(i, 0, 16);
  }
  pop();
}

function dibujarLuzInteractiva() {
  push();
  noStroke();
  if (modoLuz) {
    fill(255, 200, 100, 20);
    ellipse(mouseX, mouseY, 200, 200);
    fill(255, 230, 150, 35);
    ellipse(mouseX, mouseY, 90, 90);
  }
  pop();
}
